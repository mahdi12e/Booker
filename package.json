{
  "name": "marginalia",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "dev:api": "wrangler dev --port 8787",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json",
    "build": "npm run typecheck && vite build",
    "preview": "npm run build && wrangler dev --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply marginalia-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply marginalia-db --remote",
    "deploy": "npm run build && wrangler deploy",
    "test": "bash scripts/smoke.sh"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wrangler": "^4.0.0"
  }
}
