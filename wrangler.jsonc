{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marginalia",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "APP_URL": "https://marginalia.YOUR-SUBDOMAIN.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "marginalia-db",
      "database_id": "PASTE-D1-DATABASE-ID",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "KV", "id": "PASTE-KV-NAMESPACE-ID" }
  ],
  "r2_buckets": [
    { "binding": "AVATARS", "bucket_name": "marginalia-avatars" }
  ],
  "triggers": { "crons": ["0 3 * * *"] },
  "observability": { "enabled": true }
}
